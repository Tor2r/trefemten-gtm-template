___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Runs on Consent Initialization, before any other tag. Sets Consent Mode and UET defaults from the visitor's stored
// choice (the `c` field of the tf_consent cookie) or denied, then loads the site's TreFemten script. The SDK then
// sends the current state as an update, which also covers categories this template doesn't know about.

const createQueue = require('createQueue');
const encodeUriComponent = require('encodeUriComponent');
const getCookieValues = require('getCookieValues');
const injectScript = require('injectScript');
const JSON = require('JSON');
const makeInteger = require('makeInteger');
const setDefaultConsentState = require('setDefaultConsentState');
const setInWindow = require('setInWindow');

// The consent types this template may set. GTM requires them to be listed in the permissions, so custom categories
// added in TreFemten (tf_<key>) get their state from the SDK moments later, and count as not granted until then.
const TYPES = [
  'ad_storage',
  'ad_user_data',
  'ad_personalization',
  'analytics_storage',
  'functionality_storage',
  'personalization_storage',
  'security_storage',
  'tf_statistikk',
  'tf_markedsforing'
];

const readStoredConsent = () => {
  const values = getCookieValues('tf_consent');

  if (!values || values.length === 0) {
    return undefined;
  }

  const stored = JSON.parse(values[0]);

  if (!stored || stored.v !== 1 || !stored.c) {
    return undefined;
  }

  return stored.c;
};

const stored = readStoredConsent();

const consent = {
  ad_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  analytics_storage: 'denied',
  tf_statistikk: 'denied',
  tf_markedsforing: 'denied'
};

if (stored) {
  TYPES.forEach((type) => {
    if (stored[type] === 'granted' || stored[type] === 'denied') {
      consent[type] = stored[type];
    }
  });
} else {
  consent.wait_for_update = makeInteger(data.waitForUpdate) || 500;
}

setDefaultConsentState(consent);

// Microsoft UET follows ad_storage until the SDK sends the site's own mapping.
const uetq = createQueue('uetq');
uetq('consent', 'default', { ad_storage: consent.ad_storage });

// Tells the SDK the defaults are set, so it sends an update instead of a second default.
setInWindow('__tfGtm', true, true);

injectScript(
  'https://cdn.trefemten.no/s/' + encodeUriComponent(data.siteKey) + '.js',
  data.gtmOnSuccess,
  data.gtmOnFailure,
  'trefemten'
);


