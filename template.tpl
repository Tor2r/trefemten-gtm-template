___TESTS___

scenarios:
- name: A first visit denies everything, waits for a choice and loads the site's script
  code: |-
    mock('getCookieValues', []);

    runCode(mockData);

    assertApi('setDefaultConsentState').wasCalledWith({
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      tf_statistikk: 'denied',
      tf_markedsforing: 'denied',
      wait_for_update: 500
    });
    assertApi('setInWindow').wasCalledWith('__tfGtm', true, true);
    assertApi('injectScript').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: A returning visitor's stored choice becomes the default, without waiting
  code: |-
    mock('getCookieValues', ['{"v":1,"id":"x","s":2,"m":1,"t":1790000000,"g":["nodvendig","statistikk"],"c":{"ad_storage":"denied","analytics_storage":"granted","functionality_storage":"granted","tf_statistikk":"granted","tf_funksjonell":"granted"}}']);

    runCode(mockData);

    assertApi('setDefaultConsentState').wasCalledWith({
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'granted',
      functionality_storage: 'granted',
      tf_statistikk: 'granted',
      tf_markedsforing: 'denied'
    });
- name: A cookie in an unknown format is ignored
  code: |-
    mock('getCookieValues', ['{"v":2,"c":{"ad_storage":"granted"}}']);

    runCode(mockData);

    assertApi('setDefaultConsentState').wasCalledWith({
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      tf_statistikk: 'denied',
      tf_markedsforing: 'denied',
      wait_for_update: 500
    });
- name: A failed script load is reported to GTM
  code: |-
    mock('getCookieValues', []);
    mock('injectScript', (url, onSuccess, onFailure) => {
      onFailure();
    });

    runCode(mockData);

    assertApi('gtmOnFailure').wasCalled();
setup: |-
  const mockData = {
    siteKey: 'abc123def4',
    waitForUpdate: '500'
  };

  mock('injectScript', (url, onSuccess) => {
    onSuccess();
  });


